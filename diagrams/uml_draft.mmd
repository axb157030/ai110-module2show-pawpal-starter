classDiagram
    %% PawPal+ class design, based on pawpal.md.
    %% Keep this file updated so it matches your final implementation.

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Frequency {
        <<enumeration>>
        NONE
        DAILY
        WEEKLY
        MONTHLY
    }

    class Task {
        +str task_id
        +str name
        +str description
        +Priority priority
        +int duration_minutes
        +datetime due_date
        +datetime start_time
        +bool is_completed
        +Frequency frequency
        +mark_complete() None
        +edit(**fields) None
        +end_time() datetime
        +overlaps(other: Task) bool
        +overlap_minutes(other: Task) int
        +is_duplicate_of(other: Task) bool
        +next_occurrence(today: date) Task
        +to_dict() dict
        +from_dict(data: dict)$ Task
    }

    class Pet {
        +str pet_id
        +str name
        +str pet_type
        +str description
        +int age
        +list~str~ ailments
        +list~Task~ tasks
        +add_task(task: Task) None
        +list_tasks() list~Task~
        +get_task(task_id: str) Task
        +find_duplicate_task(task: Task) Task
        +edit_task(task_id: str, **fields) None
        +remove_task(task_id: str) None
        +edit(**fields) None
        +label() str
        +is_duplicate_of(other: Pet) bool
        +to_dict() dict
        +from_dict(data: dict, tasks_by_id: dict)$ Pet
    }

    class Owner {
        +str name
        +time available_start
        +time available_end
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +edit_pet(pet_id: str, **fields) None
        +remove_pet(pet_id: str) None
        +get_pet(pet_id: str) Pet
        +find_duplicate_pet(pet: Pet) Pet
        +filter_pets(name, pet_type, age, ailment) list~Pet~
        +get_all_tasks() list~Task~
        +pets_for_task(task: Task) list~Pet~
        +to_dict() dict
        +from_dict(data: dict)$ Owner
        +save_json(path: str) None
        +load_json(path: str)$ Owner
    }

    class Scheduler {
        +Owner owner
        +get_all_tasks() list~Task~
        +weighted_priority(task: Task, today: date) float
        +sort_by_weighted_priority(tasks: list~Task~, today: date) list~Task~
        +sort_by_due_date(tasks: list~Task~) list~Task~
        +filter_tasks(name, description, is_completed, priority, due_date, min_weighted_priority, tasks, pet_name) list~Task~
        +detect_conflicts(tasks: list~Task~) list~tuple~
        +time_block(tasks: list~Task~, day: date) list~Task~
        +next_available_slot(duration_minutes: int, after: datetime) datetime
        +mark_task_complete(task: Task, today: date) Task
        +mark_task_incomplete(task: Task) Task
        +handle_recurring_tasks(today: date) list~Task~
        +generate_daily_plan(day: date) DailyPlan
    }

    class DailyPlan {
        +date day
        +list~Task~ scheduled_tasks
        +list~Task~ skipped_tasks
        +dict pet_labels_by_task
        +list~str~ reasoning
        +total_minutes() int
        +explain() str
    }

    Owner "1" o-- "0..*" Pet : owns
    Pet "1..*" o-- "0..*" Task : has (a shared task, e.g. park trip, is added to each pet)
    Task --> Priority
    Task --> Frequency
    Scheduler "1" --> "1" Owner : reads availability/preferences
    Scheduler "1" ..> "0..*" Pet : manages tasks across (via owner.get_all_tasks)
    Scheduler ..> DailyPlan : creates
    DailyPlan "1" o-- "0..*" Task : schedules
